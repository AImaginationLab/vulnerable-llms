# Sample environment variables for vulnerable-llms
# Copy this file to .env and adjust values as needed

# Host URL for the Ollama LLM server (default Docker service)
OLLAMA_HOST=http://ollama:11434
# Models (pulled automatically on startup unless OLLAMA_AUTO_PULL=false)
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TOOL_MODEL=qwen3:0.6b
OLLAMA_AUTO_PULL=true
